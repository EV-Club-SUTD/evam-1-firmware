          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ZewMjAyknEb1WVtQAOJd-4" value="&lt;font face=&quot;Courier New&quot;&gt;setSwitchesGPIO()&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;Set all input and output pins to their correct pin modes (&lt;font face=&quot;Courier New&quot;&gt;INPUT&lt;/font&gt; or &lt;font face=&quot;Courier New&quot;&gt;OUTPUT&lt;/font&gt;)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
