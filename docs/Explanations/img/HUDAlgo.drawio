        </mxCell>
        <mxCell id="ZewMjAyknEb1WVtQAOJd-5" value="&lt;font face=&quot;Courier New&quot;&gt;attachInterrupts()&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;Set lighting and reverse pins to attach their respective interrupt functions&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="89.91" y="710" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="IVXdb9A3EyJ7HtGwM6Vm-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ZewMjAyknEb1WVtQAOJd-6" target="IVXdb9A3EyJ7HtGwM6Vm-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ZewMjAyknEb1WVtQAOJd-6" value="&lt;font face=&quot;Courier New&quot;&gt;requestCanNodeStatuses()&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;Request statuses from all CAN nodes&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="89.91" y="800" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="IVXdb9A3EyJ7HtGwM6Vm-1" value="Every&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;CORE_DATA_REFRESH_INTERVAL&amp;nbsp;&lt;/font&gt;(16&amp;nbsp;&lt;div&gt;milliseconds):&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;strokeColor=#3333FF;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="330" width="320" height="400" as="geometry" />
        </mxCell>
        <mxCell id="IVXdb9A3EyJ7HtGwM6Vm-2" value="&lt;div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;setBatteryCharacteristic();&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;setCoreCharacteristic();&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 8px; margin-right: 8px;&quot;&gt;Sets the battery and core Bluetooth characteristics, which contain the following data:&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 8px; margin-right: 8px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 8px; margin-right: 8px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Core&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 8px; margin-right: 8px;&quot;&gt;&lt;ul&gt;&lt;li&gt;Speed: car velocity 0-255km/h&lt;/li&gt;&lt;li&gt;Throttle % 0-100%&lt;/li&gt;&lt;li&gt;Brake % 0-100%&lt;/li&gt;&lt;li&gt;Reverse mode boolean&lt;/li&gt;&lt;li&gt;Calibrated steering angle (centre=128)&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Battery&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Battery State of Charge %&lt;/li&gt;&lt;li&gt;Battery Voltage&lt;/li&gt;&lt;li&gt;Battery Current (part 1, 8-bits)&lt;/li&gt;&lt;li&gt;Battery Current (part 2, 8-bits)&lt;/li&gt;&lt;li&gt;Battery Temperature&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="380" width="280" height="330" as="geometry" />
        </mxCell>
        <mxCell id="IVXdb9A3EyJ7HtGwM6Vm-3" value="Every&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;MOTOR_LOCK_MSG_REFRESH_INTERVAL&amp;nbsp;&lt;/font&gt;(1000&amp;nbsp;&lt;div&gt;milliseconds):&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;strokeColor=#3333FF;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="750" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="IVXdb9A3EyJ7HtGwM6Vm-4" value="&lt;div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;checkSendMotorLockout();&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;requestCanNodeStatuses();&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 8px; margin-right: 8px;&quot;&gt;Sends the motor lockout CAN message if the motor lockout pin is active (i.e. &lt;font face=&quot;Courier New&quot;&gt;digitalRead&lt;/font&gt; returns &lt;font face=&quot;Courier New&quot;&gt;HIGH&lt;/font&gt;).&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 8px; margin-right: 8px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 8px; margin-right: 8px;&quot;&gt;After which, request for CAN node statuses from all other CAN nodes.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="800" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="IVXdb9A3EyJ7HtGwM6Vm-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="IVXdb9A3EyJ7HtGwM6Vm-5" target="IVXdb9A3EyJ7HtGwM6Vm-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IVXdb9A3EyJ7HtGwM6Vm-5" value="&lt;font face=&quot;Courier New&quot;&gt;sendButtonCanMessages()&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;Checks if &lt;font face=&quot;Courier New&quot;&gt;lightingISRFlag&lt;/font&gt; is true (i.e. the light switch has changed state), and if yes, send CAN messages to the lighting nodes.&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;Refer to rate group&amp;nbsp;&lt;span style=&quot;background-color: transparent; text-align: center;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;DEBOUNCE_INTERVAL&lt;/font&gt; for reverser behaviour.&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="89.91" y="940" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="IVXdb9A3EyJ7HtGwM6Vm-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="IVXdb9A3EyJ7HtGwM6Vm-6" target="IVXdb9A3EyJ7HtGwM6Vm-5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="232" y="1350" />
              <mxPoint x="410" y="1350" />
              <mxPoint x="410" y="900" />
              <mxPoint x="230" y="900" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="IVXdb9A3EyJ7HtGwM6Vm-6" value="&lt;font face=&quot;Courier New&quot;&gt;checkIncomingCanMessages()&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;Checks for incoming CAN messages (specifically, only the messages for statuses) on the CAN bus and if there is an incoming value, send the value to the phone over Bluetooth via&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;setStatusCharacteristic()&lt;/font&gt;.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;In addition, it also checks for core characteristic data incoming from the CAN bus (such as speed, throttle, etc.), and changes the variables, but does NOT send the values over Bluetooth.&amp;nbsp;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="92.41" y="1090" width="280" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
