        </mxCell>
        <mxCell id="ZewMjAyknEb1WVtQAOJd-3" value="&lt;font face=&quot;Courier New&quot;&gt;setupBLE()&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;setStatusCharacteristic()&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;setBatteryCharacteristic()&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;Setup all Bluetooth services, characteristics, callbacks, descriptors and start broadcasting its presence.&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; margin-left: 20px; margin-right: 16px; margin-top: 0px;&quot;&gt;Afterwards, set initial status and battery variables, and push that data to the phones.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="89.91" y="420" width="280" height="180" as="geometry" />
