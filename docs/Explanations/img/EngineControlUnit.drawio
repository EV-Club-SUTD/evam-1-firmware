        <mxCell id="rFY7eVXZIw4cQrVmmeob-7" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;if eStopPressed&lt;/font&gt;&amp;nbsp;== 0 AND&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;motorLock&lt;/font&gt;&amp;nbsp;== 0:&lt;font face=&quot;Courier New&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;calculateWheelThrottles();&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;sendIndivThrottlesMsg();&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Calculate throttles for each individual wheel and send their values via CAN interface&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="742" y="310" width="320" height="125" as="geometry" />
