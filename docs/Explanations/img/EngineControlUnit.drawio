        <mxCell id="rFY7eVXZIw4cQrVmmeob-8" value="Every &lt;font face=&quot;Courier New&quot;&gt;WHEEL_THROTTLES_MSG_INTERVAL&amp;nbsp;&lt;/font&gt;(10 milliseconds):&amp;nbsp;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
