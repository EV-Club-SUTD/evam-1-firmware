        <mxCell id="DRljbF2BI0p0ouzewjN0-12" value="&lt;div style=&quot;line-height: 19px; white-space-collapse: preserve;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(54, 54, 11), rgb(255, 255, 255));&quot; face=&quot;Courier New&quot;&gt;initCanBus()&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="DRljbF2BI0p0ouzewjN0-11" vertex="1">
