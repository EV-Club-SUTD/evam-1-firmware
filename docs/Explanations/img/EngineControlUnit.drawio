        <mxCell id="DRljbF2BI0p0ouzewjN0-13" value="Prepares CAN messages by initialising the following:&lt;div&gt;&lt;ul style=&quot;padding-right: 0px; padding-left: 0px; margin-right: 0px;&quot;&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Setting bitrate and oscillator configurations&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Setting normal mode on CAN controller&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;Setting initial values for ECU status, E stop and &lt;br&gt;individual wheel throttle messages&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=1;points=[];autosize=1;strokeColor=none;fillColor=none;imageAspect=0;overflow=visible;" parent="DRljbF2BI0p0ouzewjN0-11" vertex="1">
