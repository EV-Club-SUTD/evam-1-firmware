        <mxCell id="rFY7eVXZIw4cQrVmmeob-5" value="Every&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;ESTOP_MSG_INTERVAL&lt;/font&gt; (1000 milliseconds):" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
