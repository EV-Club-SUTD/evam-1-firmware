        <mxCell id="rFY7eVXZIw4cQrVmmeob-6" value="&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#0000FF,#0000FF);align=left;" vertex="1" parent="1">
          <mxGeometry x="722" y="260" width="360" height="380" as="geometry" />
