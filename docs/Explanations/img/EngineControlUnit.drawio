        <mxCell id="rFY7eVXZIw4cQrVmmeob-4" value="&lt;font face=&quot;Courier New&quot;&gt;sendEStopMsg()&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Send status of E stop through CAN interface&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;" vertex="1" parent="1">
