          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="MCU3RolZ979tPYoSzu-l-60" value="Read the incoming CAN message and do the following depending on the CAN ID:&lt;div&gt;&lt;ul&gt;&lt;li&gt;INDIV_WHEEL_THROTTLES_MSG_ID: read the values of the first and second bytes and set the speeds of the front left and front right throttle to their values respectively, set the left or right motors to reverse if the fifth and sixth byte is 1 respectively&lt;/li&gt;&lt;li&gt;REV_BOOST_MSG_ID: set the ecoBoost value to the second byte of the message&lt;/li&gt;&lt;li&gt;MOTOR_LOCKOUT_MSG_ID: set the motorsLocked value to the first byte of the message&lt;/li&gt;&lt;li&gt;NODE_STATUS_REQUEST_MSG_ID: Run &lt;font face=&quot;Lucida Console&quot;&gt;sendStatus()&lt;/font&gt;&amp;nbsp;to send the current state of the node&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="VPsaro3E6v2UXJT12yXh-2" vertex="1">
          <mxGeometry x="30" y="50" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="MCU3RolZ979tPYoSzu-l-66" value="" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" parent="VPsaro3E6v2UXJT12yXh-2" vertex="1">
          <mxGeometry x="10" y="329" width="370" height="111" as="geometry" />
        </mxCell>
